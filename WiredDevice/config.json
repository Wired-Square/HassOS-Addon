{
  "version": "0.0.21",
  "name": "Wired Square Device CAN",
  "slug": "wired_square_device_can",
  "description": "This enables CAN interfaces on HassOS.",
  "url":"https://wiredsquare.com",
  "arch": ["armhf", "armv7", "aarch64"],
  "startup": "services",
  "boot": "auto",
  "apparmor": false,
  "full_access": true,
  "host_network": true,
  "init": false,
  "ingress": false,
  "privileged": ["NET_ADMIN", "NET_RAW", "SYS_ADMIN"],
  "stage": "experimental",
  "options": {
    "bitrate": "50000",
    "restart-ms": "100",
    "tx_queue_length": "1000",
    "can_controller": "mcp2515",
    "can0": "false",
    "can0_oscillator": "16000000",
    "can0_interrupt": "23",
    "can1": "false",
    "can1_oscillator": "16000000",
    "can1_interrupt": "25",
    "gvret": false,
    "gvret_port": 23,
    "gvret_bus_offset": 0,
    "gvret_can_fd": false,
    "gvret_log_level": "INFO",
    "sink": "none",
    "forward_host": "",
    "forward_port": 9323,
    "forward_api_key": "",
    "forward_database": "",
    "postgres_dsn": ""
  },
  "schema": {
    "bitrate": "str",
    "restart-ms": "str",
    "tx_queue_length": "str",
    "can_controller": "str",
    "can0": "bool",
    "can0_oscillator": "int",
    "can0_interrupt": "int",
    "can1": "bool",
    "can1_oscillator": "int",
    "can1_interrupt": "int",
    "gvret": "bool",
    "gvret_port": "int(1,65535)",
    "gvret_bus_offset": "int(0,15)",
    "gvret_can_fd": "bool",
    "gvret_log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "sink": "list(none|forward|postgres)",
    "forward_host": "str?",
    "forward_port": "int(1,65535)?",
    "forward_api_key": "password?",
    "forward_database": "str?",
    "postgres_dsn": "password?"
  },
  "map": [
    "config:rw"
  ]
}
