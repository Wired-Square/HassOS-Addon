{
  "version": "0.2.0",
  "name": "Wired Square Device CAN",
  "slug": "wired_square_device_can",
  "description": "This enables CAN interfaces on HassOS.",
  "url":"https://wiredsquare.com",
  "arch": ["armhf", "armv7", "aarch64"],
  "startup": "services",
  "boot": "auto",
  "apparmor": false,
  "full_access": true,
  "host_network": true,
  "init": false,
  "ingress": false,
  "privileged": ["NET_ADMIN", "NET_RAW", "SYS_ADMIN"],
  "stage": "experimental",
  "options": {
    "bitrate": 50000,
    "restart-ms": 100,
    "tx_queue_length": 1000,
    "can_controller": "mcp2515",
    "can0": false,
    "can0_oscillator": 16000000,
    "can0_interrupt": 23,
    "can1": false,
    "can1_oscillator": 16000000,
    "can1_interrupt": 25,
    "can_fd": false,
    "log_level": "INFO",
    "gvret": false,
    "gvret_port": 23,
    "gvret_bus_offset": 0,
    "framelink": false,
    "framelink_port": 120,
    "framelink_device_id": "",
    "forward": false,
    "forward_host": "",
    "forward_port": 9323,
    "forward_api_key": "",
    "forward_database": ""
  },
  "schema": {
    "bitrate": "int(1,1000000)",
    "restart-ms": "int(0,)",
    "tx_queue_length": "int(0,)",
    "can_controller": "list(mcp2515)",
    "can0": "bool",
    "can0_oscillator": "int",
    "can0_interrupt": "int",
    "can1": "bool",
    "can1_oscillator": "int",
    "can1_interrupt": "int",
    "can_fd": "bool",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "gvret": "bool",
    "gvret_port": "int(1,65535)",
    "gvret_bus_offset": "int(0,15)",
    "framelink": "bool",
    "framelink_port": "int(1,65535)",
    "framelink_device_id": "str?",
    "forward": "bool",
    "forward_host": "str?",
    "forward_port": "int(1,65535)?",
    "forward_api_key": "password?",
    "forward_database": "str?"
  },
  "map": [
    "config:rw"
  ]
}
