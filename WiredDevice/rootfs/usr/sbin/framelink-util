source /usr/lib/wired/can-server-common

SERVER="/usr/sbin/framelink-server.py"

ARGS=()


function get_conf () {
  #
  # Populate configuration variables from the JSON config file
  #

  read_shared_conf

  PORT=$(conf_get framelink_port)
  DEVICE_ID=$(conf_get framelink_device_id)
}


function show_conf () {
  #
  # Show current config
  #

  echo "iface: $IFACES"
  echo "framelink_port: $PORT"
  echo "framelink_device_id: ${DEVICE_ID:-(hostname)}"
  echo "can_fd: $CAN_FD"
  echo "log_level: $LOG_LEVEL"
}


function usage () {
  #
  # Print usage information
  #

  echo "Usage:"
  echo "$0 [ args | showconf | start ]"
  echo ""
  echo "  args     - print the framelink-server arguments built from the add-on options"
  echo "  showconf - print the current FrameLink configuration"
  echo "  start    - exec the FrameLink endpoint, replacing this process"

  exit 0
}


function build_args () {
  #
  # Assemble the framelink-server argument list from the add-on options
  #

  get_conf

  ARGS=()
  append_shared_args
  ARGS+=(--port "$PORT")

  #
  # Left unset, the server falls back to the hostname
  #
  append_if_set --device-id "$DEVICE_ID"
}


function start_server () {
  #
  # Replace this process with the endpoint, so s6 supervises it directly and
  # its SIGTERM handler gets a clean shutdown.
  #

  build_args
  require_ifaces

  echo "Starting FrameLink endpoint on ${IFACES} port ${PORT}"

  exec python3 "$SERVER" "${ARGS[@]}"
}


case $1 in

  args)
    build_args
    echo "${ARGS[@]}"
    ;;
  showconf)
    get_conf
    show_conf
    ;;
  start)
    start_server
    ;;
  *)
    usage
    ;;
esac
