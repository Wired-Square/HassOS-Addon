CONF="/data/options.json"
SERVER="/usr/sbin/wiretap-server.py"

#
# The upstream default cache lives in $HOME, which is ephemeral in a container.
# /data is the persistent add-on volume, so a backlog survives a restart.
#
CACHE="/data/wiretap-cache.db"

ARGS=()


function get_conf () {
  #
  # Populate configuration variables from the JSON config file
  #

  json=$(cat ${CONF})

  PORT=$(echo $json | jq -r '.gvret_port')
  BUS_OFFSET=$(echo $json | jq -r '.gvret_bus_offset')
  CAN_FD=$(echo $json | jq -r '.gvret_can_fd')
  LOG_LEVEL=$(echo $json | jq -r '.gvret_log_level')
  FORWARD=$(echo $json | jq -r '.forward')
  FORWARD_HOST=$(echo $json | jq -r '.forward_host')
  FORWARD_PORT=$(echo $json | jq -r '.forward_port')
  FORWARD_API_KEY=$(echo $json | jq -r '.forward_api_key')
  FORWARD_DATABASE=$(echo $json | jq -r '.forward_database')

  #
  # Every CAN interface that is present becomes a GVRET bus, in enumeration
  # order: can0 is bus 0 + offset, can1 is bus 1 + offset, and so on.
  #
  IFACES=$(/usr/sbin/can-util enum | tr ' ' ',')
}


function secret_state () {
  #
  # Report whether a credential is present, without revealing it
  #

  [ -n "$1" ] && echo "(set)" || echo "(unset)"
}


function show_conf () {
  #
  # Show current config. Secrets are masked so this is safe to paste into a log.
  #

  echo "iface: $IFACES"
  echo "gvret_port: $PORT"
  echo "gvret_bus_offset: $BUS_OFFSET"
  echo "gvret_can_fd: $CAN_FD"
  echo "gvret_log_level: $LOG_LEVEL"
  echo "forward: $FORWARD"

  if [ "$FORWARD" == "true" ]; then
    echo "forward_host: $FORWARD_HOST"
    echo "forward_port: $FORWARD_PORT"
    echo "forward_database: $FORWARD_DATABASE"
    echo "forward_api_key: $(secret_state "$FORWARD_API_KEY")"
  fi
}


function usage () {
  #
  # Print usage information
  #

  echo "Usage:"
  echo "$0 [ args | showconf | start ]"
  echo ""
  echo "  args     - print the wiretap-server arguments built from the add-on options"
  echo "  showconf - print the current GVRET configuration"
  echo "  start    - exec the GVRET server, replacing this process"

  exit 0
}


function build_args () {
  #
  # Assemble the wiretap-server argument list from the add-on options.
  #
  # The gateway key is deliberately passed by environment rather than argv, so
  # it never appears in the process list. That also keeps "args" printable.
  #

  get_conf

  ARGS=(
    --iface "$IFACES"
    --host "0.0.0.0"
    --port "$PORT"
    --bus-offset "$BUS_OFFSET"
    --log-level "$LOG_LEVEL"
  )

  if [ "$CAN_FD" == "true" ]; then
    ARGS+=(--can-fd)
  fi

  if [ "$FORWARD" == "true" ]; then
    ARGS+=(--forward-enable --forward-host "$FORWARD_HOST" --forward-port "$FORWARD_PORT")
    ARGS+=(--pg-cache-path "$CACHE")

    if [ -n "$FORWARD_DATABASE" ]; then
      ARGS+=(--forward-database "$FORWARD_DATABASE")
    fi
  fi
}


function start_server () {
  #
  # Replace this process with the GVRET server. Running it as PID 1 lets its
  # own SIGTERM handler shut down cleanly when the add-on is stopped, and a
  # crash exits the container so the Supervisor restarts the add-on.
  #

  build_args

  if [ -z "$IFACES" ]; then
    echo "Error: No CAN interfaces found. Is the CAN controller configured?"
    exit 2
  fi

  if [ "$FORWARD" == "true" ]; then
    if [ -z "$FORWARD_HOST" ]; then
      echo "Error: Forwarding is enabled but forward_host is not set."
      exit 2
    fi

    export WIRETAP_FORWARD_TOKEN="$FORWARD_API_KEY"
  fi

  echo "Starting GVRET server on ${IFACES} port ${PORT} (forward: ${FORWARD})"

  exec python3 "$SERVER" "${ARGS[@]}"
}


case $1 in

  args)
    build_args
    echo "${ARGS[@]}"
    ;;
  showconf)
    get_conf
    show_conf
    ;;
  start)
    start_server
    ;;
  *)
    usage
    ;;
esac
